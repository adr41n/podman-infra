# Copy this file to .env and fill in your values.
# .env is excluded from version control (see .gitignore).
#
# Pi-hole v6 uses FTLCONF_* settings (see https://docs.pi-hole.net/docker/configuration/).
# Only secrets and environment-specific values live here; the rest are set in
# PiHole.container.

# Timezone (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=Europe/London

# Web interface / API password (was WEBPASSWORD in v5)
FTLCONF_webserver_api_password=your_password_here

# Conditional forwarding to your router for local name resolution.
# Format: <enabled>,<cidr>,<router-ip>[#port],<local-domain>
FTLCONF_dns_revServers=true,192.168.0.0/24,192.168.0.1#53,lan

# Local network domain name.
FTLCONF_dns_domain_name=lan

[Unit]
Description=Plex hairpin NAT loopback rule
After=network.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'sysctl -w net.ipv4.conf.all.route_localnet=1 && iptables -t nat -C OUTPUT -d 80.189.232.59 -p tcp -j DNAT --to-destination 127.0.0.1:32400 2>/dev/null || iptables -t nat -A OUTPUT -d 80.189.232.59 -p tcp -j DNAT --to-destination 127.0.0.1:32400'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
